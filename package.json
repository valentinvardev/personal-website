{
  "name": "valentinvarela-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && next build",
    "db:plan": "node --env-file=.env scripts/db-plan.mjs",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:sql": "node --env-file=.env scripts/db-sql.mjs",
    "db:studio": "prisma studio",
    "db:sync": "npm run db:push && npm run db:sql",
    "dev": "next dev --turbo",
    "guard:time": "node scripts/guard-time.mjs",
    "panel:export": "node --env-file=.env scripts/panel-export.ts",
    "panel:reset": "node --env-file=.env scripts/panel-reset.ts",
    "panel:restore": "node --env-file=.env scripts/panel-restore.ts",
    "panel:rollup": "node --env-file=.env scripts/panel-job.ts rollup",
    "postinstall": "prisma generate",
    "prebuild": "node scripts/guard-time.mjs",
    "preview": "next build && next start",
    "start": "next start",
    "test": "node scripts/guard-time.mjs && node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@supabase/supabase-js": "^2.110.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.5.2"
}
