# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ---- Panel de admin (/admin) ----
# Mínimo 8 caracteres. Usá algo largo y único en producción.
ADMIN_PASSWORD="cambiame-ya-12345"

# ---- Base de datos (Supabase, COMPARTIDA con el proyecto de facturación) ----
# ⚠️ El parámetro `schema=personal_site` es OBLIGATORIO: aísla las tablas de
# este proyecto en su propio schema de Postgres. Sin él, Prisma intentaría
# gestionar `public`, donde viven las tablas del otro proyecto.
# DATABASE_URL: "Transaction pooler" (puerto 6543) + pgbouncer — la usa la app.
# DIRECT_URL:   "Session pooler" o conexión directa (puerto 5432) — migraciones.
# ⚠️ connection_limit: NO usar 1. Con una sola conexión, las queries de todos
# los visitantes se ponen en cola y la que espera más de pool_timeout (10 s por
# defecto) tira P2024 → la página responde 500 (incidente 2026-08-29). Cada
# query tarda ~1 s contra us-east-1, así que 10 conexiones + 20 s de espera
# es el mínimo razonable para un servidor persistente (pm2).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&schema=personal_site"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=personal_site"

# ---- Supabase (opcional por ahora; para Storage de capturas, etc.) ----
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_…"
SUPABASE_SECRET_KEY="sb_secret_…"

# ---- Panel de medición (/panel), privado ----
# "true" enciende el panel; ausente o cualquier otro valor lo deja apagado y
# la ruta devuelve 404. Comparte la sesión y la contraseña de /admin.
# ⚠️ Todas las variables del panel se validan como string opcional en env.js:
# ese archivo se importa desde next.config.js, así que un valor malformado
# impediría que arranque el proceso que sirve el sitio público.
PANEL_ENABLED="true"
